<!-- Double Confirmation Modal -->
<div id="confirm-modal" class="modal-overlay hidden">
  <div class="modal-card">
    <div class="modal-header">
      <span id="confirm-modal-title">अंतिम सबमिशन की पुष्टि</span>
      <button class="btn btn-secondary" onclick="closeConfirmModal()">✕</button>
    </div>
    <div class="modal-body" id="confirm-modal-body">
      <!-- Dynamic confirmation step text will be injected here -->
    </div>
    <div class="modal-actions" id="confirm-modal-actions">
      <!-- Dynamic action buttons injected here -->
    </div>
  </div>
</div>
